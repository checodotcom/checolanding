<section class="hero" id="inicio">
  <h1 class="wordmark">checodotcom</h1>
  <nav class="hero-nav" aria-label="Secciones">
    <a href="#portafolio">Portafolio</a>
    <a href="#contact">Contacto</a>
    <a href="/about">Acerca</a>
  </nav>
</section>

<script>
  // 1) El wordmark entra (400 ms) en cuanto la tipografía está lista.
  // 2) El menú entra 1,5 s después de que la página cargó por completo (recursos y tipografías).
  const wordmark = document.querySelector(".wordmark");
  const nav = document.querySelector(".hero-nav");
  const loaded = new Promise<void>((resolve) =>
    document.readyState === "complete" ? resolve() : window.addEventListener("load", () => resolve(), { once: true }),
  );

  document.fonts.ready.then(() => requestAnimationFrame(() => wordmark?.classList.add("is-ready")));
  Promise.all([loaded, document.fonts.ready]).then(() => setTimeout(() => nav?.classList.add("is-ready"), 1500));

  // Scroll-linked: a medida que las tarjetas suben sobre la primera sección, esta se desenfoca y se apaga.
  const hero = document.querySelector<HTMLElement>(".hero");
  const update = () => {
    const p = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.85)));
    hero?.style.setProperty("--p", p.toFixed(3));
  };
  update();
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
</script>
