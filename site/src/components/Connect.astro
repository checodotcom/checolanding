---
import {getSettings} from '../data/settings';
const {social}=await getSettings();
---
<section class="glass panel connect"><h2 class="contact-title">Si algo se parece a lo que buscas, escríbeme</h2><div class="social-links">{social.filter(s=>s.url).map(s=><a href={s.url} target="_blank" rel="me noopener noreferrer">{s.label} ↗</a>)}<a href="/contact">Contacto ↗</a></div></section>