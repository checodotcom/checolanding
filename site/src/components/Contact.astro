---
import { getSettings } from "../data/settings";

const { social } = await getSettings();
const PLACEHOLDER = "[tu correo]";
---

<section class="section" id="contact" aria-labelledby="contact-label">
  <div class="two-col" data-reveal>
    <h2 class="label" id="contact-label">02 — Contacto</h2>
    <div class="col-body">
      <p>¿Tienes un proyecto o una marca que necesita sitio? Escríbeme y platicamos.</p>

      <form class="lead" id="lead-form" novalidate>
        <label class="email-field" data-placeholder={PLACEHOLDER}>
          <span class="sr-only">Tu correo</span>
          <input
            type="email"
            name="email"
            placeholder={PLACEHOLDER}
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            autocapitalize="off"
          />
        </label>
        <button class="send" type="submit" hidden>Continuar</button>
      </form>

      <ul class="links">
        {
          social.map((s) => (
            <li>{s.url ? <a href={s.url} target="_blank" rel="me noopener noreferrer">{s.label}</a> : <span class="pending">{s.label}</span>}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<dialog class="modal" id="lead-dialog" aria-labelledby="lead-dialog-title">
  <div class="modal-panel">
    <h2 class="sr-only" id="lead-dialog-title">Escríbeme</h2>
    <button class="modal-close" type="button" data-close aria-label="Cerrar">
      <svg width="13" height="13" viewBox="0 0 13 13" aria-hidden="true"><path d="M1 1l11 11M12 1L1 12" stroke="currentColor" stroke-width="1.2" fill="none" /></svg>
    </button>

    <form class="modal-form" id="lead-dialog-form" novalidate>
      <label class="field">
        <span class="label">Tu correo</span>
        <input class="field-email" type="email" name="email" placeholder="tu@correo.com" autocomplete="email" inputmode="email" spellcheck="false" autocapitalize="off" required />
      </label>

      <label class="field">
        <span class="label">Nombre completo</span>
        <input type="text" name="name" autocomplete="name" maxlength="120" required />
      </label>

      <label class="field">
        <span class="label">Mensaje</span>
        <textarea name="message" rows="5" maxlength="250" placeholder="Cuéntame qué tienes en mente."></textarea>
        <span class="small field-count" aria-hidden="true"><span id="lead-count">0</span> / 250</span>
      </label>

      <!-- Anzuelo para bots: invisible para personas; si llega con valor, se descarta. -->
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <p class="small modal-status" id="lead-status" role="status" aria-live="polite"></p>

      <div class="modal-actions">
        <button class="text-button" type="button" data-close>Cancelar</button>
        <button class="send" type="submit">Enviar</button>
      </div>
    </form>

    <div class="modal-done" id="lead-done" hidden>
      <p class="label">Mensaje enviado</p>
      <p class="done-title">Listo, <span id="lead-done-name"></span>.</p>
      <p class="done-sub">Te respondo a <span class="done-email" id="lead-done-email"></span> lo antes posible.</p>
      <div class="modal-actions">
        <button class="send" type="button" id="lead-done-close">Ver portafolio</button>
      </div>
    </div>
    <!-- Anuncio para lectores de pantalla: la confirmación visual aparece al ocultar el formulario. -->
    <p class="sr-only" id="lead-live" aria-live="polite"></p>
  </div>
</dialog>

<script>
  // Algo@dominio.terminación (mínimo 2 letras al final: .com, .mx, .io…)
  const VALID = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // ——— campo de correo de la página ———
  const form = document.getElementById("lead-form") as HTMLFormElement;
  const field = form.querySelector<HTMLElement>(".email-field")!;
  const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
  const next = form.querySelector<HTMLButtonElement>(".send")!;

  // La caja y su línea miden siempre lo mismo (el largo de "[tu correo]"). Si el correo no cabe, el
  // <input> se ensancha hacia la izquierda por el espacio libre; si aun así no cabe, la letra baja
  // un paso de la escala (42 → 26 → 16) y, solo como último recurso, el texto se desplaza por dentro.
  const SIZES = [42, 26, 16];
  const wide = window.matchMedia("(min-width: 721px)");

  function fit() {
    input.style.width = "";
    input.style.fontSize = "";
    if (!input.value) return;
    const box = field.clientWidth;
    const margin = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--margin")) || 34;
    // Espacio libre a la izquierda de la caja (en estrecho no hay: la caja ya ocupa la columna).
    const room = box + (wide.matches ? Math.max(0, field.getBoundingClientRect().left - margin) : 0);
    for (const size of SIZES) {
      input.style.fontSize = `${size}px`;
      input.style.width = "0px";
      const text = input.scrollWidth + 2; // + el cursor
      if (text <= room || size === SIZES[SIZES.length - 1]) {
        input.style.width = `${Math.min(Math.max(text, box), room)}px`;
        return;
      }
    }
  }

  function sync() {
    fit();
    const ok = VALID.test(input.value.trim());
    if (next.hidden === ok) {
      next.hidden = !ok;
      if (ok) {
        next.classList.remove("is-in");
        void next.offsetWidth; // reinicia la animación de entrada
        next.classList.add("is-in");
      }
    }
  }
  input.addEventListener("input", sync);
  window.addEventListener("resize", fit);

  // ——— diálogo ———
  const dialog = document.getElementById("lead-dialog") as HTMLDialogElement;
  const dForm = document.getElementById("lead-dialog-form") as HTMLFormElement;
  const dEmail = dForm.elements.namedItem("email") as HTMLInputElement;
  const dName = dForm.elements.namedItem("name") as HTMLInputElement;
  const dMessage = dForm.elements.namedItem("message") as HTMLTextAreaElement;
  const dHoney = dForm.elements.namedItem("website") as HTMLInputElement;
  const dSend = dForm.querySelector<HTMLButtonElement>(".send")!;
  const dStatus = document.getElementById("lead-status")!;
  const dCount = document.getElementById("lead-count")!;
  const dDone = document.getElementById("lead-done")!;
  const panel = dialog.querySelector<HTMLElement>(".modal-panel")!;
  const contactLog = {
    info: (body: string, attributes: Record<string, string> = {}) =>
      window.posthog?.logger?.info(body, attributes),
    warn: (body: string, attributes: Record<string, string> = {}) =>
      window.posthog?.logger?.warn(body, attributes),
  };
  let sent = false;

  function showDone(name: string, email: string) {
    const from = panel.offsetHeight;
    document.getElementById("lead-done-name")!.textContent = name.split(/\s+/)[0];
    document.getElementById("lead-done-email")!.textContent = email;
    document.getElementById("lead-live")!.textContent = `Mensaje enviado. Te respondo a ${email} lo antes posible.`;
    dForm.hidden = true;
    dDone.hidden = false;
    panel.classList.add("is-done");
    document.getElementById("lead-done-close")!.focus(); // el botón de envío desaparece: el foco no se pierde
    if (reduceMotion.matches) return;
    // El panel crece o se encoge con suavidad en lugar de saltar de tamaño.
    panel.style.height = "auto";
    const to = panel.offsetHeight;
    panel.style.height = `${from}px`;
    void panel.offsetHeight;
    panel.style.height = `${to}px`;
    setTimeout(() => (panel.style.height = ""), 300);
  }

  // Desde el campo de la página el correo ya viene escrito; desde el botón del header llega vacío (el
  // visitante todavía no lo había escrito) y el foco cae primero en ese campo.
  let fromPage = true;

  function openDialog(email: string, page = true) {
    const entrypoint = page ? "contact_section" : "floating_header";
    window.posthog?.capture("contact_form_opened", { entrypoint });
    contactLog.info("contact form opened", { entrypoint });
    fromPage = page;
    dEmail.value = email;
    panel.classList.remove("is-done");
    panel.style.height = "";
    dForm.hidden = false;
    dDone.hidden = true;
    dStatus.textContent = "";
    dialog.showModal();
    requestAnimationFrame(() => dialog.classList.add("is-open"));
    (!dEmail.value ? dEmail : dName.value ? dMessage : dName).focus();
  }

  function closeDialog(afterClose?: () => void) {
    if (!dialog.open) return;
    dialog.classList.remove("is-open");
    const finish = () => {
      dialog.close();
      afterClose?.();
      if (sent) {
        // Tras un envío exitoso se limpia todo para no dejar el correo a la vista.
        sent = false;
        dForm.reset();
        dCount.textContent = "0";
        input.value = "";
        sync();
      } else if (fromPage) {
        input.value = dEmail.value.trim() || input.value;
        sync();
      }
    };
    if (reduceMotion.matches) return finish();
    let done = false;
    const once = () => { if (!done) { done = true; finish(); } };
    dialog.addEventListener("transitionend", once, { once: true });
    setTimeout(once, 340); // respaldo si no llega transitionend
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (VALID.test(input.value.trim())) openDialog(input.value.trim());
  });

  // Botones "Contacto" fuera de esta sección (el del header flotante): abren el mismo formulario.
  document.querySelectorAll("[data-open-contact]").forEach((b) =>
    b.addEventListener("click", () => openDialog(VALID.test(input.value.trim()) ? input.value.trim() : "", false)),
  );

  dialog.addEventListener("cancel", (e) => {
    e.preventDefault(); // Esc: se cierra con animación
    closeDialog();
  });
  dialog.addEventListener("click", (e) => {
    // El clic en el fondo cae sobre el <dialog> mismo, no sobre el panel.
    if (e.target === dialog) closeDialog();
  });
  dialog.querySelectorAll("[data-close]").forEach((b) => b.addEventListener("click", () => closeDialog()));

  // Tras el envío, el único botón cierra el diálogo y lleva al portafolio.
  document.getElementById("lead-done-close")!.addEventListener("click", () =>
    closeDialog(() =>
      document.getElementById("portafolio")?.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth" }),
    ),
  );

  dMessage.addEventListener("input", () => (dCount.textContent = String(dMessage.value.length)));

  dForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    dStatus.textContent = "";
    if (!VALID.test(dEmail.value.trim())) {
      dStatus.textContent = "Revisa tu correo.";
      return dEmail.focus();
    }
    if (dName.value.trim().length < 2) {
      dStatus.textContent = "Escribe tu nombre completo.";
      return dName.focus();
    }
    if (dHoney.value) return;

    dSend.disabled = true;
    dSend.textContent = "Enviando…";
    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: dEmail.value.trim(),
          name: dName.value.trim(),
          message: dMessage.value.trim(),
          website: dHoney.value,
        }),
      });
      if (!res.ok) throw new Error(String(res.status));
      window.posthog?.capture("contact_form_submitted");
      contactLog.info("contact form submitted");
      sent = true;
      showDone(dName.value.trim(), dEmail.value.trim());
    } catch {
      contactLog.warn("contact form submission failed");
      dStatus.textContent = "No se pudo enviar. Intenta de nuevo.";
    } finally {
      dSend.disabled = false;
      dSend.textContent = "Enviar";
    }
  });

  sync();
</script>
