---
import { formatDate, getProjects } from "../data/projects";

const all = await getProjects();
const projects = all.filter((p) => !p.demo);
const demos = all.filter((p) => p.demo);
const first = projects[0] ?? all[0];

// "Eleventy, Nunjucks" → ["Eleventy,", "Nunjucks"]: cada tag es una pieza que no se parte; si no caben
// en una línea, bajan uno debajo del otro (alineados a la derecha). La coma se queda con su tag.
const tags = (type: string) => {
  const parts = type.split(",").map((t) => t.trim()).filter(Boolean);
  return parts.map((t, i) => (i < parts.length - 1 ? `${t},` : t));
};

const row = (p: (typeof all)[number], current: boolean) => {
  const data = {
    "data-name": p.name,
    "data-desc": p.desc,
    "data-url": p.url ?? "",
    "data-image": p.image ?? "",
    "data-placeholder": p.placeholder,
    "aria-current": current ? "true" : undefined,
    class: "project",
  };
  return { data, p };
};
const projectRows = projects.map((p, i) => row(p, i === 0));
const demoRows = demos.map((p) => row(p, false));
const hasDemos = demos.length > 0;
---

<section class="glass panel portfolio" id="portafolio" aria-labelledby="portfolio-label">
  <div class="portfolio-grid" data-mode="projects">
    <div class="portfolio-list" data-list="projects">
      <h2 class="label" id="portfolio-label">
        <button type="button" class="mode-toggle" data-mode-target="projects" aria-pressed="true">Algunos trabajos</button>
      </h2>
      <ul class="projects">
        {
          projectRows.map(({ data, p }) => (
            <li>
              {p.url ? (
                <a {...data} href={p.url} target="_blank" rel="noopener noreferrer">
                  <span class="date">{formatDate(p)}</span>
                  <span class="name">{p.name}</span>
                  <span class="type">{tags(p.type).map((t) => (<><span class="tag">{t}</span>{" "}</>))}</span>
                </a>
              ) : (
                <button {...data} type="button">
                  <span class="date">{formatDate(p)}</span>
                  <span class="name">{p.name}</span>
                  <span class="type">{tags(p.type).map((t) => (<><span class="tag">{t}</span>{" "}</>))}</span>
                </button>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    {
      hasDemos && (
        <div class="portfolio-list portfolio-list--demos" data-list="demos">
          <h2 class="label" id="demos-label">
            <button type="button" class="mode-toggle" data-mode-target="demos" aria-pressed="false">Demos</button>
          </h2>
          <ul class="projects">
            {demoRows.map(({ data, p }) => (
              <li>
                {p.url ? (
                  <a {...data} href={p.url} target="_blank" rel="noopener noreferrer">
                    <span class="date">{formatDate(p)}</span>
                    <span class="name">{p.name}</span>
                    <span class="type">{tags(p.type).map((t) => (<><span class="tag">{t}</span>{" "}</>))}</span>
                  </a>
                ) : (
                  <button {...data} type="button">
                    <span class="date">{formatDate(p)}</span>
                    <span class="name">{p.name}</span>
                    <span class="type">{tags(p.type).map((t) => (<><span class="tag">{t}</span>{" "}</>))}</span>
                  </button>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="portfolio-media" aria-live="polite">
      <!-- El enlace de la imagen duplica el del título: se oculta al teclado y a lectores de pantalla. -->
      <a
        class="media-link"
        id="media-link-image"
        href={first.url}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
      >
        <div class="media-image" id="media-image" role="img" aria-label={`Imagen de ${first.name}`}>
          {first.image ? <img src={first.image} alt="" /> : <span>{first.placeholder}</span>}
        </div>
      </a>
      <div class="media-caption">
        <h3 class="project-title">
          <a id="media-link-title" href={first.url} target="_blank" rel="noopener noreferrer">{first.name}</a>
        </h3>
        <p class="small" id="media-desc">{first.desc}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".project"));
  const image = document.getElementById("media-image")!;
  const imageLink = document.getElementById("media-link-image") as HTMLAnchorElement;
  const titleLink = document.getElementById("media-link-title") as HTMLAnchorElement;
  const desc = document.getElementById("media-desc")!;

  // Sin URL, el <a> queda sin href: es texto plano, no un enlace.
  function setHref(a: HTMLAnchorElement, url: string) {
    if (url) {
      a.href = url;
      a.target = "_blank";
      a.rel = "noopener noreferrer";
    } else {
      a.removeAttribute("href");
      a.removeAttribute("target");
      a.removeAttribute("rel");
    }
  }

  function show(el: HTMLElement) {
    const { name = "", desc: d = "", url = "", image: src = "", placeholder = "" } = el.dataset;
    items.forEach((b) => (b === el ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current")));
    image.setAttribute("aria-label", `Imagen de ${name}`);
    image.replaceChildren();
    if (src) {
      const img = document.createElement("img");
      img.src = src;
      img.alt = "";
      image.appendChild(img);
    } else {
      const span = document.createElement("span");
      span.textContent = placeholder;
      image.appendChild(span);
    }
    setHref(imageLink, url);
    setHref(titleLink, url);
    titleLink.textContent = name;
    desc.textContent = d;
  }

  // En táctil no hay hover: el primer toque selecciona (vista previa) y el segundo, sobre la
  // fila ya activa, navega. Los toques también disparan mouseenter y focus, así que esos dos
  // solo seleccionan con cursor real y con teclado, para no navegar al primer toque.
  const noHover = window.matchMedia("(hover: none)");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const media = document.querySelector<HTMLElement>(".portfolio-media")!;

  // En una sola columna la vista previa queda debajo de la lista, a veces fuera de pantalla: tras el
  // primer toque se desplaza con suavidad lo justo para que la imagen y su pie se vean completos.
  function revealPreview() {
    const r = media.getBoundingClientRect();
    const m = parseFloat(getComputedStyle(media).scrollMarginBottom) || 0;
    if (r.top >= m && r.bottom <= window.innerHeight - m) return; // ya se ve entera, con su margen
    media.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth", block: "nearest" });
  }

  items.forEach((el) => {
    el.addEventListener("mouseenter", () => {
      if (!noHover.matches) show(el);
    });
    el.addEventListener("focus", () => {
      if (el.matches(":focus-visible")) show(el);
    });
    el.addEventListener("click", (e) => {
      const active = el.getAttribute("aria-current") === "true";
      const opensProject = el instanceof HTMLAnchorElement && (!noHover.matches || active);
      if (noHover.matches && el instanceof HTMLAnchorElement && !active) e.preventDefault();
      if (opensProject) window.posthog?.capture("portfolio_project_opened", { source: "list" });
      show(el);
      if (noHover.matches && !active) revealPreview();
    });
  });

  [imageLink, titleLink].forEach((link) =>
    link.addEventListener("click", () => {
      if (link.hasAttribute("href")) window.posthog?.capture("portfolio_project_opened", { source: "preview" });
    }),
  );

  // ——— Proyectos / Demos ———
  // Dos columnas con el mismo listado. Al elegir «Demos» (hover con cursor, toque o teclado) la cuadrícula se
  // espeja: la vista previa pasa a la izquierda y la lista de demos queda a la derecha, orientada a la derecha.
  const grid = document.querySelector<HTMLElement>(".portfolio-grid")!;
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>(".mode-toggle"));
  let hoverTimer = 0;

  function setMode(mode: "projects" | "demos") {
    if (grid.dataset.mode === mode) return;
    grid.dataset.mode = mode;
    grid.classList.remove("is-switching");
    void grid.offsetWidth; // reinicia la animación de entrada
    grid.classList.add("is-switching");
    toggles.forEach((t) => t.setAttribute("aria-pressed", String(t.dataset.modeTarget === mode)));
    const list = grid.querySelector(`[data-list="${mode}"]`);
    list?.querySelector<HTMLElement>(".project")?.dispatchEvent(new CustomEvent("select-project"));
  }

  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
  toggles.forEach((t) => {
    const target = t.dataset.modeTarget as "projects" | "demos";
    t.addEventListener("click", () => setMode(target));
    t.addEventListener("pointerenter", () => {
      if (!canHover.matches) return;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setMode(target), 140); // un respiro, para no cambiar por rozar
    });
    t.addEventListener("pointerleave", () => clearTimeout(hoverTimer));
  });
  items.forEach((el) => el.addEventListener("select-project", () => show(el)));
</script>
