---
const items = [
 ["/", "Inicio", "M3 10 12 3l9 7v11h-6v-7H9v7H3Z"],
 ["/projects", "Portafolio", "M3 7h18v14H3ZM8 7V3h8v4M9 7v14M15 7v14"],
 ["/blog", "Blog", "M5 3h9l5 5v13H5ZM14 3v6h5M8 13h8M8 17h6"],
 ["/about", "Acerca", "M20 21v-3a6 6 0 0 0-6-6h-4a6 6 0 0 0-6 6v3M16 5a4 4 0 1 1-8 0 4 4 0 0 1 8 0"],
 ["/contact", "Contacto", "m3 11 18-8-8 18-3-8ZM10 13 21 3"],
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<nav class="dock glass" aria-label="Principal">
 {items.map(([href,label,d]) => <a href={href} aria-label={label} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined} data-tooltip={label}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d}/></svg></a>)}
</nav>
<script>
 // En la página de inicio el dock espera: no aparece mientras la primera sección (.hero) sigue a la vista.
 const hero = document.querySelector(".hero");
 const dock = document.querySelector(".dock");
 if (hero && dock) {
  const update = () => dock.classList.toggle("is-away", window.scrollY < window.innerHeight * 0.5);
  update();
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
 }
</script>
