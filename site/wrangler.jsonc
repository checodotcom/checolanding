{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checolanding",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Logs en el panel de Cloudflare (Observability). Aquí y no en el panel, para que cada deploy los conserve.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // El Worker solo se ejecuta para /api/*; el resto se sirve directo desde dist/.
    "run_worker_first": ["/api/*"]
  },
  // Sin destination_address a propósito: así el correo de destino no queda en el repo.
  // MAIL_TO se define como secreto en Cloudflare (Settings → Variables and Secrets).
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    "MAIL_FROM": "contacto@checodot.com",
    "ALLOWED_ORIGINS": "https://checodot.com"
  }
}
